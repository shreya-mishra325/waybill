
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  hmacSecret  String   @map("hmac_secret")
  createdAt   DateTime @default(now()) @map("created_at")

  events      Event[]
  deliveries  Delivery[]
  replays     Replay[]
  memberships TenantMembership[]

  @@map("tenants")
}

model Event {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  type        String
  payload     Json?
  payloadS3Key String? @map("payload_s3_key")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  deliveries  Delivery[]
  outbox      Outbox?
  deadLetters DeadLetter[]
  replay      Replay?

  @@index([tenantId])
  @@map("events")
}

model Delivery {
  id            String    @id @default(uuid())
  eventId       String    @map("event_id")
  tenantId      String    @map("tenant_id")
  targetUrl     String    @map("target_url")
  status        DeliveryStatus @default(PENDING)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  event         Event     @relation(fields: [eventId], references: [id])
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  deadLetter    DeadLetter?

  @@index([tenantId, status])
  @@map("deliveries")
}

enum DeliveryStatus {
  PENDING
  IN_FLIGHT
  SUCCEEDED
  FAILED
  DEAD_LETTERED
}

model Outbox {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  event       Event    @relation(fields: [eventId], references: [id])

  @@index([published])
  @@map("outbox")
}

model DeadLetter {
  id           String   @id @default(uuid())
  eventId      String   @map("event_id")
  deliveryId   String   @unique @map("delivery_id")
  tenantId     String   @map("tenant_id")
  targetUrl    String   @map("target_url")
  lastError    String?  @map("last_error")
  attemptCount Int      @map("attempt_count")
  payloadS3Key String   @map("payload_s3_key")
  createdAt    DateTime @default(now()) @map("created_at")

  event        Event    @relation(fields: [eventId], references: [id])
  delivery     Delivery @relation(fields: [deliveryId], references: [id])
  replay       Replay?

  @@index([tenantId])
  @@map("dead_letters")
}

model Replay {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  sourceDeadLetterId String   @unique @map("source_dead_letter_id")
  eventId            String   @unique @map("event_id")
  idempotencyKey     String   @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  sourceDeadLetter  DeadLetter @relation(fields: [sourceDeadLetterId], references: [id])
  event            Event      @relation(fields: [eventId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("replays")
}

model User {
  id          String   @id @default(uuid())
  githubId    String   @unique @map("github_id")
  githubLogin String   @map("github_login")
  createdAt   DateTime @default(now()) @map("created_at")
  sessions    AuthSession[]
  memberships TenantMembership[]

  @@map("users")
}

model TenantMembership {
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  apiKeys   ApiKey[]

  @@id([userId, tenantId])
  @@index([tenantId])
  @@map("tenant_memberships")
}

model AuthSession {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  csrfToken String   @map("csrf_token")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("auth_sessions")
}

model OAuthLogin {
  stateHash    String   @id @map("state_hash")
  browserHash  String   @map("browser_hash")
  codeVerifier String   @map("code_verifier")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("oauth_logins")
}

model ApiKey {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  createdByUserId  String   @map("created_by_user_id")
  name            String
  tokenHash       String   @unique @map("token_hash")
  expiresAt       DateTime @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime @default(now()) @map("created_at")
  membership      TenantMembership @relation(fields: [createdByUserId, tenantId], references: [userId, tenantId], onDelete: Cascade)

  @@index([tenantId, createdAt, id])
  @@map("api_keys")
}
