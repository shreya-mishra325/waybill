{
  "name": "waybill",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --watch packages/api/src/index.ts",
    "dev:worker": "bun run --watch packages/worker/src/index.ts",
    "prisma:generate": "bunx prisma@5.22.0 generate --schema packages/shared/prisma/schema.prisma",
    "prisma:migrate": "bunx prisma@5.22.0 migrate dev --name init --schema packages/shared/prisma/schema.prisma",
    "check:aws": "bun run packages/shared/scripts/check-aws.ts",
    "seed:tenant": "bun run packages/shared/scripts/seed-tenant.ts",
    "post:event": "bun run packages/shared/scripts/post-event.ts",
    "post:event:large": "bun run packages/shared/scripts/post-event.ts --large",
    "dev:receiver": "bun run --watch packages/shared/scripts/test-receiver.ts",
    "dev:poller": "bun run --watch packages/worker/src/outbox-poller.ts",
    "ping:receiver": "bun run packages/shared/scripts/ping-receiver.ts",
    "test:fairness": "bun run packages/shared/scripts/test-fairness.ts",
    "test:fairness:backlog": "bun run packages/shared/scripts/test-fairness.ts --backlog",
    "setup:replica": "bun run packages/shared/scripts/setup-replica.ts",
    "test:replica": "bun run packages/shared/scripts/test-replica.ts",
    "test:replay": "bun run packages/shared/scripts/test-replay.ts",
    "dev:web": "bun run --cwd packages/web dev",
    "build:web": "bun run --cwd packages/web build",
    "check:web": "bun run --cwd packages/web typecheck",
    "check:shared": "tsc --noEmit -p packages/shared/tsconfig.json",
    "check:api": "tsc --noEmit -p packages/api/tsconfig.json",
    "check:worker": "tsc --noEmit -p packages/worker/tsconfig.json",
    "check:scripts": "tsc --noEmit -p packages/shared/scripts/tsconfig.json",
    "check:backend": "bun run check:shared && bun run check:api && bun run check:worker && bun run check:scripts",
    "test:backend": "bun test packages/api packages/worker packages/shared",
    "prisma:validate": "bunx prisma@5.22.0 validate --schema packages/shared/prisma/schema.prisma",
    "monitoring:up": "bun run packages/shared/scripts/setup-monitoring.ts",
    "monitoring:check": "bun run packages/shared/scripts/setup-monitoring.ts --check",
    "monitoring:down": "docker compose --env-file .env.monitoring -f docker-compose.monitoring.yml down",
    "test:monitoring": "bun --env-file=.env.monitoring packages/shared/scripts/test-monitoring.ts",
    "test:monitoring:flow": "bun run packages/shared/scripts/test-monitoring-flow.ts",
    "test:monitoring:overhead": "bun run packages/shared/scripts/benchmark-monitoring.ts",
    "test:load": "bun run packages/shared/scripts/test-load.ts",
    "test:load:pressure": "bun run packages/shared/scripts/test-load.ts --pressure"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
