# Postgres
DATABASE_URL=postgresql://webhook:webhook@localhost:5432/webhook_platform

# Redis — caching, rate limiting, circuit breaker state (NOT the queue anymore)
REDIS_URL=redis://localhost:6379

# AWS — SQS (queue) + S3 (large payload / archive storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-free-tier-access-key
AWS_SECRET_ACCESS_KEY=your-free-tier-secret-key
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/xxxxxxxxxxxx/waybill-deliveries
S3_BUCKET_NAME=waybill-payload-archive

# API
API_PORT=3000
NODE_ENV=development

# Security
HMAC_SECRET_DEFAULT=change-me-in-production

# Delivery worker tuning
MAX_DELIVERY_ATTEMPTS=8
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000
SQS_MAX_MESSAGE_BYTES=262144
