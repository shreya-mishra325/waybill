# Postgres
DATABASE_URL=postgresql://webhook:webhook@127.0.0.1:15432/webhook_platform

READ_REPLICA_DATABASE_URL=postgresql://waybill_reader:local-reader-only@127.0.0.1:15433/webhook_platform

# Redis (cache, rate limit, circuit breaker later; not the queue)
REDIS_URL=redis://localhost:6379

# AWS (SQS queue, S3 payload archive)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-free-tier-access-key
AWS_SECRET_ACCESS_KEY=your-free-tier-secret-key
SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/xxxxxxxxxxxx/waybill-deliveries
S3_BUCKET_NAME=waybill-payload-archive

# API
API_PORT=3000
NODE_ENV=development

# Independent per-tenant token buckets: burst capacity and tokens per second
INGESTION_RATE_LIMIT_CAPACITY=10
INGESTION_RATE_LIMIT_REFILL_PER_SECOND=10
DELIVERY_RATE_LIMIT_CAPACITY=10
DELIVERY_RATE_LIMIT_REFILL_PER_SECOND=10

# Test receiver
RECEIVER_PORT=4000
RECEIVER_URL=http://127.0.0.1:4000/webhook

RECEIVER_TENANT_ID=your-development-tenant-id
RECEIVER_HMAC_SECRET=the-same-secret-as-that-tenant-record

# Delivery worker tuning
MAX_DELIVERY_ATTEMPTS=8
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000
SQS_MAX_MESSAGE_BYTES=262144

METRICS_ENABLED=false
METRICS_HOST=127.0.0.1
API_METRICS_PORT=9100
PUBLISHER_METRICS_PORT=9101
WORKER_METRICS_PORT=9102
